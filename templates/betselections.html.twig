{% extends "base.html.twig" %}

{% block title %}Paris Multiples{% endblock %}

{% block body %}

    <!--  BET SELECTIONS PAGE START -->
    <main>
         <!-- INTRODUCTION  START   -->
                  <div class="container mb-2">
                      <div class="image-text-container">
                          <!-- PICTURE MATCH WIN  START -->
                          <img src="{{ asset('img/img52.png') }}" class="img-home" alt="multiple wins image">
                          <!-- PICTURE MATCH WIN END -->

                          <div class=" row justify-content-center">

                                  <div class="text-button-container">

                                      <!--  TITLE  MULTIPLE MATCHES START-->
                                      <img src="{{ asset('img/img53.png') }}"  class="img-bet2 text-center" alt="logo super bowl">
                                      <!--  TITLE  MULTIPLE MATCHES END -->

                                          <!-- TEXT INTRO  -->
                                         <div class="intro-home mt-5">
                                             <h4 class="anton-regular4 mt-5"> Faites vos jeux sur plusieurs matchs </h4>
                                             <h4 class="anton-regular4"> Remportez de multiples victoires !</h4>
                                         </div>
                                          <!-- TEXT INTRO  -->
                                  </div>
                          </div>
                      </div>
                  </div>
              <!-- INTRODUCTION  END   -->

             <!--TITLE BET MATCH  START -->
             <h2 class="text-center anton-regular2 mt-5 neon-text"> FAITES VOS JEUX </h2>
             <!--TITLE BET MATCH  END -->

        <div class="container">
            <div class="row justify-content-center text-center mb-5">

            {% for footballMatch in footballMatches %}

                    {% include '_cardmultiplebets.html.twig' with {'form': forms[footballMatch.id], 'footballMatch': footballMatch} %}

             {% endfor %}

           </div>
        </div>
    </main>

{% endblock %}

            {% block custom_javascripts %}

          <!-- FLATPICKR   CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

            <script>

              flatpickr('.flatpickr-date', {
                       dateFormat: 'Y-m-d',
                       locale: 'fr',
                       disableMobile: true,
                       defaultDate: 'today',
                       minDate: 'today',
                       altInput: true,
                       altFormat: 'd M Y',

                  });

            </script>
{% endblock %}