{% extends "base.html.twig" %}

{% block title %}Parier sur les Matchs{% endblock %}

{% block body %}

    <!--  BET SELECTIONS PAGE START -->
    <main>
        <!-- INTRODUCTION  START   -->
        <div class="text-center"><img src="{{ asset('img/logo3NLF.png') }}" class="img-fluid imgNLF" alt="NLF logo"></div>
        <h1 class="text-center">Sélection de Paris-Sportifs</h1>
        <div class="d-flex justify-content-center"><img src="{{ asset('img/img31.png') }}" class=" img-fluid d-block w-90" alt="image miser"></div>
        <!-- INTRODUCTION  END   -->

        <div class="mb-2 red"><h2 class="text-center rectangle1"> Les équipes</h2></div>
        <div class="container">
            <div class="row justify-content-center text-center">


    {% for footballMatch in footballMatches %}

            <!-- CREATION MANY FORMS FOR EACH FOOTBALL MATCH WITH ID / START-->
           <div class="text-center">
               <div class="d-inline-block">
               {{ form_start(forms[footballMatch.id]) }}

            <div class="card mt-5 text-center" style="width: 25rem;">
                <ul class="list-group list-group-flush">

                    <li class="list-group-item">

                    </li>

                    <li class="list-group-item">

                        <!-- MATCH DATE START -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar3" viewBox="0 0 16 16">
                            <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                            <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                        </svg> {{footballMatch.matchDate|date('d/m/Y')}}
                        <!-- MATCH DATE END -->

                        <!-- MATCH HOUR START -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
                            <path d="M8.5 5.6a.5.5 0 1 0-1 0v2.9h-3a.5.5 0 0 0 0 1H8a.5.5 0 0 0 .5-.5V5.6z"/>
                            <path d="M6.5 1A.5.5 0 0 1 7 .5h2a.5.5 0 0 1 0 1v.57c1.36.196 2.594.78 3.584 1.64a.715.715 0 0 1 .012-.013l.354-.354-.354-.353a.5.5 0 0 1 .707-.708l1.414 1.415a.5.5 0 1 1-.707.707l-.353-.354-.354.354a.512.512 0 0 1-.013.012A7 7 0 1 1 7 2.071V1.5a.5.5 0 0 1-.5-.5zM8 3a6 6 0 1 0 .001 12A6 6 0 0 0 8 3z"/>
                        </svg>Début:{{footballMatch.hourStart|date('H:i')}}_
                        <!--  MATCH HOUR START-END -->

                        <!-- MATCH HOUR END -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
                            <path d="M8.5 5.6a.5.5 0 1 0-1 0v2.9h-3a.5.5 0 0 0 0 1H8a.5.5 0 0 0 .5-.5V5.6z"/>
                            <path d="M6.5 1A.5.5 0 0 1 7 .5h2a.5.5 0 0 1 0 1v.57c1.36.196 2.594.78 3.584 1.64a.715.715 0 0 1 .012-.013l.354-.354-.354-.353a.5.5 0 0 1 .707-.708l1.414 1.415a.5.5 0 1 1-.707.707l-.353-.354-.354.354a.512.512 0 0 1-.013.012A7 7 0 1 1 7 2.071V1.5a.5.5 0 0 1-.5-.5zM8 3a6 6 0 1 0 .001 12A6 6 0 0 0 8 3z"/>
                        </svg>Fin:{{footballMatch.hourFinish|date('H:i')}}
                        <!-- MATCH HOUR END-END -->

                    </li>

                    <!-- TEAM1 START -->
                    <li class="list-group-item">
                        <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam" alt="logo">
                        {{ footballMatch.team1.teamName }}
                    </li>
                    <!-- TEAM1 END -->

                    <!-- TEAM2 START -->
                    <li class="list-group-item">
                        <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam" alt="logo">
                        {{ footballMatch.team2.teamName }}
                    </li>
                    <!-- TEAM2 END -->

                    <!-- MONEY BET START -->
                    <!--<div class="row justify-content-center">-->
                        <div class=" rectangle2 blue text-center col-sm mt-2">
                            <h4 class="text-center text-light">Mise</h4>

                            <p class="text-center mt-5 mb-5 text-light"> Sélectionner l'équipe sur laquelle vous souhaitez miser :</p>
                            <div class="text-center mb-2 text-light">{{ form_row(forms[footballMatch.id].team) }}</div>

                            <div class="text-center col-6 mx-auto mt-5 mb-5 text-light" >{{ form_row(forms[footballMatch.id].wagerMade) }}</div>

                            <div class="text-center col-6 mx-auto mb-2 mb-5 text-light">{{ form_row(forms[footballMatch.id].dateWagerMade) }}</div>

                        </div>
                   <!-- </div>-->
                    <!-- MONEY BET END -->

                    <!-- BUTTON CONFIRM START-->
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-lg btn-danger">Validation</button>
                    </div>

                    <!-- BUTTON CONFIRM END-->

                </ul>
            </div>
            <!-- CREATION MANY FORMS FOR EACH FOOTBALL MATCH WITH ID / END-->
            {{ form_end(forms[footballMatch.id]) }}
           </div>
           </div>
        {% endfor %}
    </div>

{% endblock %}

            {% block custom_javascripts %}

          <!-- FLATPICKR   CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

            <script>

              flatpickr('.flatpickr-date', {
                       dateFormat: 'Y-m-d',
                       locale: 'fr',
                       disableMobile: true,
                       defaultDate: 'today',
                       minDate: 'today',
                       altInput: true,
                       altFormat: 'd M Y',

                  });

            </script>
{% endblock %}