{% extends "base.html.twig" %}

{% block title %}Visualiser un Match{% endblock %}

{% block body %}

    <!--  WATCH ONE MATCH PAGE START -->
    <main>

        <!-- INTRODUCTION  START   -->
        <div class="text-center"><img src="{{ asset('img/logo3NLF.png') }}" class="img-fluid imgNLF" alt="NLF logo"></div>
        <h1 class="text-center">Le Match</h1>
        <div class="d-flex justify-content-center"><img src="{{ asset('img/img30.png') }}" class=" img-fluid d-block w-90" alt="image joueur"></div>
        <!-- INTRODUCTION  END   -->

        <div class="container-fluid">

            <!-- BLOCK MATCH DESCRIPTION  START-->
            <div class="row justify-content-around">

                <div class=" rectangle1 red text-center col-sm mt-2">
                    <h1>
                        <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" fill="currentColor" class="bi bi-flag-fill" viewBox="0 0 16 16">
                            <path d="M14.778.085A.5.5 0 0 1 15 .5V8a.5.5 0 0 1-.314.464L14.5 8l.186.464-.003.001-.006.003-.023.009a12.435 12.435 0 0 1-.397.15c-.264.095-.631.223-1.047.35-.816.252-1.879.523-2.71.523-.847 0-1.548-.28-2.158-.525l-.028-.01C7.68 8.71 7.14 8.5 6.5 8.5c-.7 0-1.638.23-2.437.477A19.626 19.626 0 0 0 3 9.342V15.5a.5.5 0 0 1-1 0V.5a.5.5 0 0 1 1 0v.282c.226-.079.496-.17.79-.26C4.606.272 5.67 0 6.5 0c.84 0 1.524.277 2.121.519l.043.018C9.286.788 9.828 1 10.5 1c.7 0 1.638-.23 2.437-.477a19.587 19.587 0 0 0 1.349-.476l.019-.007.004-.002h.001"/>
                        </svg> Match
                    </h1>
                    <h5>Statut: {{footballMatch.statut }}</h5>
                    <h5>Score: {{footballMatch.scoreTeam1 }} _ {{footballMatch.scoreTeam2 }}</h5>
                </div>

                <div class=" rectangle2 blue text-left col-sm mt-2">
                    <h5 class="text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-calendar3" viewBox="0 0 16 16">
                            <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                            <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                        </svg> Date:{{footballMatch.matchDate|date('d/m/Y')}}</h5>

                    <p class="text-center mt-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
                            <path d="M8.5 5.6a.5.5 0 1 0-1 0v2.9h-3a.5.5 0 0 0 0 1H8a.5.5 0 0 0 .5-.5V5.6z"/>
                            <path d="M6.5 1A.5.5 0 0 1 7 .5h2a.5.5 0 0 1 0 1v.57c1.36.196 2.594.78 3.584 1.64a.715.715 0 0 1 .012-.013l.354-.354-.354-.353a.5.5 0 0 1 .707-.708l1.414 1.415a.5.5 0 1 1-.707.707l-.353-.354-.354.354a.512.512 0 0 1-.013.012A7 7 0 1 1 7 2.071V1.5a.5.5 0 0 1-.5-.5zM8 3a6 6 0 1 0 .001 12A6 6 0 0 0 8 3z"/>
                        </svg> Heure début:{{footballMatch.hourStart|date('H:i')}}_</p>

                    <p class="text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
                            <path d="M8.5 5.6a.5.5 0 1 0-1 0v2.9h-3a.5.5 0 0 0 0 1H8a.5.5 0 0 0 .5-.5V5.6z"/>
                            <path d="M6.5 1A.5.5 0 0 1 7 .5h2a.5.5 0 0 1 0 1v.57c1.36.196 2.594.78 3.584 1.64a.715.715 0 0 1 .012-.013l.354-.354-.354-.353a.5.5 0 0 1 .707-.708l1.414 1.415a.5.5 0 1 1-.707.707l-.353-.354-.354.354a.512.512 0 0 1-.013.012A7 7 0 1 1 7 2.071V1.5a.5.5 0 0 1-.5-.5zM8 3a6 6 0 1 0 .001 12A6 6 0 0 0 8 3z"/>
                        </svg> Heure fin:{{footballMatch.hourFinish|date('H:i')}}</p>

                    <p class="text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" fill="currentColor" class="bi bi-cloud-sun" viewBox="0 0 16 16">
                            <path d="M7 8a3.5 3.5 0 0 1 3.5 3.555.5.5 0 0 0 .624.492A1.503 1.503 0 0 1 13 13.5a1.5 1.5 0 0 1-1.5 1.5H3a2 2 0 1 1 .1-3.998.5.5 0 0 0 .51-.375A3.502 3.502 0 0 1 7 8zm4.473 3a4.5 4.5 0 0 0-8.72-.99A3 3 0 0 0 3 16h8.5a2.5 2.5 0 0 0 0-5h-.027z"/>
                            <path d="M10.5 1.5a.5.5 0 0 0-1 0v1a.5.5 0 0 0 1 0v-1zm3.743 1.964a.5.5 0 1 0-.707-.707l-.708.707a.5.5 0 0 0 .708.708l.707-.708zm-7.779-.707a.5.5 0 0 0-.707.707l.707.708a.5.5 0 1 0 .708-.708l-.708-.707zm1.734 3.374a2 2 0 1 1 3.296 2.198c.199.281.372.582.516.898a3 3 0 1 0-4.84-3.225c.352.011.696.055 1.028.129zm4.484 4.074c.6.215 1.125.59 1.522 1.072a.5.5 0 0 0 .039-.742l-.707-.707a.5.5 0 0 0-.854.377zM14.5 6.5a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1z"/>
                        </svg> Météo:{{footballMatch.weather}}</p>

                </div>

            </div>
            <!-- BLOCK MATCH DESCRIPTION  END-->

            <!-- BLOCK TEAM 1 DESCRIPTION  START-->
            <div class="row justify-content-center">
                <div class="rectangle3 white text-center text-dark mt-2">
                    <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam mb-2 text-center " alt="logo">
                    <h4 class="mt-2 mb-3"> Equipe: {{ footballMatch.team1.teamName }} </h4>

                    <!-- ODDSTEAM TEAM START -->
                    <p> <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-bar-chart-line-fill text-warning" viewBox="0 0 16 16">
                            <path d="M11 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h1V7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7h1V2z"/>
                        </svg> Cote de l'équipe: {{ footballMatch.team1.oddsteam }}</p>
                    <!-- ODDSTEAM TEAM END -->

                    <!-- FOOTBALL TEAM TOTAL NUMBER START -->
                    <p> <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-people-fill text-danger" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                        </svg> Nombre de joueurs: {{ footballPlayers1|length }} </p>
                    <!-- FOOTBALL TEAM TOTAL NUMBER END -->

                    {% for player in footballPlayers1 %}

                     <!-- FOOTBALL PLAYER NAME START -->
                    <p> <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-person-circle text-primary" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                        </svg> Nom du joueur: {{ player.lastName }} {{ player.firstName }} _ </p>
                        <!-- FOOTBALL PLAYER NAME END -->

                    {% endfor %}
                </div>

            </div>
            <!-- BLOCK TEAM 1 DESCRIPTION  END-->

            <!-- BLOCK TEAM 2 DESCRIPTION  START-->
            <div class="row justify-content-center">
                <div class="rectangle3 white text-center text-dark mt-2">
                    <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam mb-2 text-center" alt="logo">
                    <h4 class="mt-2 mb-3"> Equipe:{{ footballMatch.team2.teamName }} </h4>

                    <!-- ODDSTEAM TEAM START -->
                    <p><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-bar-chart-line-fill text-warning" viewBox="0 0 16 16">
                            <path d="M11 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h1V7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7h1V2z"/>
                        </svg>Cote de l'équipe: {{ footballMatch.team2.oddsteam }}</p>
                    <!-- ODDSTEAM TEAM END -->

                    <!-- FOOTBALL TEAM TOTAL NUMBER START -->
                    <p> <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-people-fill text-danger" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                        </svg> Nombre de joueurs: {{ footballPlayers2|length }}</p>


                    {% for player in footballPlayers2 %}

                        <!-- FOOTBALL PLAYER NAME START -->
                        <p> <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-person-circle text-primary" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                            </svg> Nom du Joueur: {{ player.lastName }} {{ player.firstName }} _ </p>
                        <!-- FOOTBALL PLAYER NAME END -->

                    {% endfor %}
                </div>

            </div>
            <!-- BLOCK TEAM 2 DESCRIPTION  END-->

            <!-- COMMENTS  START-->
            <div class="row justify-content-center">
            <div class=" rectangle1 orange text-center col-sm mt-2">
                <h4> Commentaires:</h4>
                <p>{{footballMatch.comments}} </p>
            </div>
        </div>
            <!-- COMMENTS  END-->

            <!-- BUTTON BET START-->
            {% if footballMatch.statut == 'Prochainement' %}
            <div class="text-center mb-5"><a href="{{ path('miser', { 'footballMatch' : footballMatch.id }) }}"  class="btn btn-primary btn-lg mt-5">Miser sur le Match</a></div>
            {% endif %}
            <!-- BUTTON BET END-->


        </div>
    </main>
    <!--  WATCH ONE MATCH PAGE END -->
{% endblock %}