{% extends "base.html.twig" %}

{% block title %}Visualiser un Match{% endblock %}

{% block body %}

    <!--  WATCH ONE MATCH PAGE START -->
    <main>
        <!-- INTRODUCTION  START   -->
        <div class="container mb-2">

                <div class="image-text-container">
                            <!-- PICTURE MATCH STADE START -->
                            <img src="{{ asset('img/img40.png') }}" class="img-match-detail" alt="Match stade image">
                            <!-- PICTURE MATCH STADE END -->

                        <div class="text-button-container">
                                <!--  TITLE MATCH START-->
                                <img src="{{ asset('img/logo4.png') }}"  class="img-match-nlf" alt="logo super bowl">
                                <img src="{{ asset('img/vs.png') }}"  class="img-match-nlf2" alt="logo VS">
                                <!--  TITLE MATCH END -->

                            <!-- TEXT MATCH DETAIL START  -->
                            <div class="intro-home mt-5">
                                <h4 class="anton-regular4 mt-5">Plongez au coeur de l'action</h4>
                                <h4 class="anton-regular4">et ne manquez aucun détail</h4>
                                <h4 class="anton-regular4">de votre match</h4>
                            </div>
                            <!-- TEXT MATCH DETAIL END  -->
                        </div>
                </div>
        </div>
        <!-- INTRODUCTION  END   -->

        <!-- MATCH DETAILS  START   -->
        <div class="container mt-5 mb-2">

            <div class="image-text-container">
                    <div class="text-button-container">

                        <!-- BLOC MATCH DAY START -->
                        <img src="{{ asset('img/img41.png') }}" class="img-match-detail" alt="Match-day title">

                        <!-- TEAM1 LOGO & NAME -->
                        <p class="detail-match-name mt-5">
                            <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam mb-2 text-center " alt="logo team1 & name">
                            {{ footballMatch.team1.teamName }}

                        </p>

                        <!-- VS LOGO -->
                        <img src="{{ asset('img/vs2.png') }}" class="imgteam" alt="Match-stade picture">

                        <!-- TEAM2 LOGO & NAME -->
                        <p class="detail-match-name">
                            <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam mb-2 mt-5 text-center " alt="logo team2 & name">
                          {{ footballMatch.team2.teamName }}
                        </p>

                        <!-- SCORE & COMMENT MATCH -->
                        <h5 class="comment-size2 neon-text">Score : {{footballMatch.scoreTeam1 }} - {{footballMatch.scoreTeam2 }}</h5>
                        <p class="comment-size mb-5"> {{footballMatch.comments}} </p>

                    </div>
                <!-- BLOC MATCH DAY END -->

                <!-- BLOC DETAILS MATCH START -->
                        <div class="text-button-container">

                            <!--  NEON TOP-->
                            <img src="{{ asset('img/neontop.png') }}"  class="img-match-nlf3" alt="neon top">

                            <!-- TEXT MATCH DETAIL START  -->

                                <h4 class="anton-regular4 "> Date {{footballMatch.matchDate|date('d/m/Y')}}</h4>
                                <h4 class=" text-danger anton-regular4 mt-3">{{footballMatch.statut }}</h4>
                                <h4 class="anton-regular4 mt-3">Début {{footballMatch.hourStart|date('H:i')}}</h4>
                                <h4 class="anton-regular4 mt-3">Fin {{footballMatch.hourFinish|date('H:i')}}</h4>
                                <h4 class="anton-regular4 mt-3">Météo {{footballMatch.weather}}</h4>


                            <!-- NEON BOTTOM  -->
                            <img src="{{ asset('img/neonbottom.png') }}"  class="img-match-nlf3" alt="neon bottom">

                        </div>
                <!-- BLOC DETAILS MATCH END-->
            </div>
        </div>
        <!-- MATCH DETAILS  END   -->

        <!--TEAM 1 DETAILS START-->
        <div class="container mt-5 mb-2">

            <div class="image-text-container">
                <div class="text-button-container">

                    <!-- BLOC MATCH DAY START -->
                    <img src="{{ asset('img/teamtitle.png') }}" class="img-match-detail2" alt="team-detail picture">

                    <!-- TEAM1 LOGO & NAME -->
                    <p class="detail-match-name mt-5">
                        <h4 class="comment-size4 neon-text"> {{ footballMatch.team1.teamName }} </h4>
                        <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam mb-2 text-center " alt="logo team1 & name">
                    </p>

                    <!-- SCORE & COMMENT MATCH -->
                    <p class="comment-size3"> Cote de l'équipe: {{ footballMatch.team1.oddsteam }}</p>
                    <p class="comment-size3 mb-5"> Nombre de joueurs: {{ footballPlayers1|length }} </p>

                </div>
                <!-- BLOC MATCH DAY END -->

                <!-- BLOC DETAILS TEAM START -->
                <div class="text-button-container">

                    <!--  NEON TOP-->
                    <img src="{{ asset('img/neontop.png') }}"  class="img-match-nlf3" alt="neon top">

                    <!-- TEAM PLAYER START  -->
                    <div class="players-container">
                        {% for player in footballPlayers1 %}
                            <div class="player-name">{{ player.firstName }} {{ player.lastName }}</div>
                        {% endfor %}
                    </div>
                    <!-- TEAM PLAYER END -->


                    <!-- NEON BOTTOM  -->
                    <img src="{{ asset('img/neonbottom.png') }}"  class="img-match-nlf3" alt="neon bottom">

                </div>
                <!-- BLOC DETAILS MATCH END-->
            </div>
        </div>
        <!--TEAM 1  DETAILS END-->

        <!--TEAM 2 DETAILS START-->
        <div class="container mt-5 mb-2">

            <div class="image-text-container">
                <div class="text-button-container">

                    <!-- BLOC MATCH DAY START -->
                    <img src="{{ asset('img/teamtitle.png') }}" class="img-match-detail2" alt="team-detail picture">

                    <!-- TEAM2 LOGO & NAME -->
                    <p class="detail-match-name mt-5">
                    <h4 class="comment-size4 neon-text"> {{ footballMatch.team2.teamName }} </h4>
                    <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam mb-2 text-center " alt="logo team1 & name">
                    </p>

                    <!-- SCORE & COMMENT MATCH -->
                    <p class="comment-size3"> Cote de l'équipe: {{ footballMatch.team2.oddsteam }}</p>
                    <p class="comment-size3 mb-5"> Nombre de joueurs: {{ footballPlayers2|length }} </p>

                </div>
                <!-- BLOC MATCH DAY END -->

                <!-- BLOC DETAILS TEAM START -->
                <div class="text-button-container">

                    <!--  NEON TOP-->
                    <img src="{{ asset('img/neontop.png') }}"  class="img-match-nlf3" alt="neon top">

                    <!-- TEAM 2  PLAYER START  -->
                    <div class="players-container">
                        {% for player in footballPlayers2 %}
                            <div class="player-name">{{ player.firstName }} {{ player.lastName }}</div>
                        {% endfor %}
                    </div>
                    <!-- TEAM 2  PLAYER END -->

                    <!-- NEON BOTTOM  -->
                    <img src="{{ asset('img/neonbottom.png') }}"  class="img-match-nlf3" alt="neon bottom">

                </div>
                <!-- BLOC DETAILS MATCH END-->
            </div>
        </div>
        <!--TEAM 2  DETAILS END-->

            <!-- BUTTON BET START-->
            {% if footballMatch.statut == 'Prochainement' %}

                <!--TITLE BET MATCH  START -->
                <h2 class="text-center comment-size4 neon-text mt-5"> FAITES VOS JEUX </h2>
                <!--TITLE BET MATCH  END -->

            <div class="text-center mt-5 mb-5">
                <a href="{{ path('miser', { 'footballMatch' : footballMatch.id }) }}"  class="btn btn-lg btn-danger login-btn2">
                    Miser sur le Match</a>
            </div>
            {% endif %}
            <!-- BUTTON BET END-->


    </main>
    <!--  WATCH ONE MATCH PAGE END -->
{% endblock %}