{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<!--FORMULAIRE MODIFIER USER START -->

<main class="container-fluid">

    <div class=" block text-center">
        <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="Logo SuperBowl">
        <h1 class="mt-3 text-center text-light">Modification Mon Compte</h1>

    </div>

    <section class="container">
        <div class="row">
            <div >
                {{ form_start(edituserForm) }}
                <fieldset>

                    <div class="mt-5">
                    {{ form_row(edituserForm.last_name) }}
                    </div>

                    <div class="mt-2">
                    {{ form_row(edituserForm.first_name) }}
                    </div>

                    <div class="mt-2">
                    {{ form_row(edituserForm.email) }}
                    </div>

                </fieldset>


                <div class="text-center mb-3">
                    <button type="submit" class="btn btn-lg btn-danger mt-5 text-dark">Modifier</button>
                    {{ form_end(edituserForm) }}
                </div>

            </div>
        </div>
    </section>

</main>

<!-- FORMULAIRE MODIFIER USER END -->

{% endblock %}
