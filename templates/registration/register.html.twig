{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<!--FORMULAIRE INSCRIPTION START -->

<main class="container-fluid">

    <div class=" block text-center">
        <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="Logo SuperBowl">
        <h1 class="mt-3 text-center text-light">Inscription</h1>

    </div>

    <section class="container">
        <div class="row">
            <div >
                {{ form_start(registrationForm) }}
                <fieldset>

                    {{ form_row(registrationForm.last_name) }}
                    {{ form_row(registrationForm.first_name) }}
                    {{ form_row(registrationForm.email) }}
                </fieldset>

                {{ form_row(registrationForm.password) }}
                {{ form_row(registrationForm.RGPDConsent) }}

                <div class="text-center mb-3">
                    <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Envoyer</button>
                    {{ form_end(registrationForm) }}
                </div>

            </div>
        </div>
    </section>

</main>

<!--FORMULAIRE INSCRIPTION END -->

{% endblock %}
