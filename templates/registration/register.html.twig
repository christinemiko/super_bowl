{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<!--FORMULAIRE INSCRIPTION START -->

<main>

    <div class=" block text-center">
        <img src="{{ asset('img/img35.png') }}" class="img-login" alt="Logo SuperBowl">
    </div>

    <div class="container-md ">
        <div class="row justify-content-center">

            <!-- FLASH MESSAGE START -->
            {% for flashError in app.flashes('error') %}
                <div class="alert alert-danger">
                    {{ flashError }}
                </div>
            {% endfor %}
            <!-- FLASH MESSAGE END -->
            <div class="col-md-6">
                {{ form_start(registrationForm) }}
                <fieldset>

                    <div class="text-center form-field-label">
                        {{ form_row(registrationForm.last_name, {
                            'attr': {'placeholder': 'Nom'}
                        }) }}
                    </div>

                    <div class="form-field-label">
                        {{ form_row(registrationForm.first_name, {
                            'attr': {'placeholder': 'Prénom'}
                        }) }}
                    </div>

                    <div class="form-field-label">
                       {{ form_row(registrationForm.email, {
                            'attr': {'placeholder': 'Email'}
                        }) }}
                    </div>

                </fieldset>

                <div class="form-field-label">
                    {{ form_row(registrationForm.password.first, {
                        'attr': {'placeholder': 'Mot de passe'}
                    }) }}
                </div>

                <div class="form-field-label">
                    {{ form_row(registrationForm.password.second, {
                        'attr': {'placeholder': 'Confirmez le mot de passe'}
                    }) }}
                </div>

                <div class="text-center mb-5">
                    <button type="submit" class="btn btn-lg btn-danger mt-2 regis-btn">Envoyer</button>
                    {{ form_end(registrationForm) }}
                </div>

            </div>
        </div>
    </div>

</main>
<!--FORMULAIRE INSCRIPTION END -->

{% endblock %}
