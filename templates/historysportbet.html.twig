{% extends "base.html.twig" %}

{% block title %}Historiques des Mises{% endblock %}

{% block body %}
    <!-- USER INFORMATIONS START -->
    <main>
        <!-- LOGO  START -->
        <div class=" text-center">
            <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="logo superBowl">
        </div>
        <!-- LOGO  END -->

        <!-- TITTLE START -->
        <div class=" red mt-5"><h2 class="text-center text-light rectangle2">Historique des Mises</h2></div>
        <!-- TITTLE END -->

    <!-- SPORT BET  HISTORY START -->
    <div class="container-fluid">
        <div class="table-responsive">

            <table class="table table-light table-striped table-bordered table-hover">
                <thead >
                <tr>

                    <th class="text-center">Date du Match</th>
                    <th class="text-center">Heure de début</th>
                    <th class="text-center">Heure de fin</th>
                    <th class="text-center">Noms des équipes</th>
                    <th class="text-center">Date Mise</th>
                    <th class="text-center">Mise effectuée</th>
                    <th class="text-center">Gains</th>
                    <th class="text-center">Pertes</th>
                    <th class="text-center">Statut Match</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>

                {% for sportbet in sportbets %}
                <tr>
                    <td class="text-center">{{ sportbet.footballMatch.matchDate|date('d/m/Y')}}</td>
                    <td class="text-center">{{ sportbet.footballMatch.hourStart|date('H:i')}}</td>
                    <td class="text-center">{{ sportbet.footballMatch.hourFinish|date('H:i')}}</td>
                    <td class="text-center">{{ sportbet.team.teamName }}</td>
                    <td class="text-center">{{ sportbet.dateWagerMade|date('d/m/Y')}}</td>
                    <td class="text-center">{{ sportbet.wagerMade }}</td>
                    <td class="text-center">{{ sportbet.moneyGain }}</td>
                    <td class="text-center">{{ sportbet.moneyLose }}</td>
                    <td class="text-center">{{ sportbet.footballMatch.statut }}</td>


                    <td class="col-md-2 text-center">
                        {% if sportbet.footballMatch.statut == 'Prochainement' and sportbet.isDeleted == false %}

                            <!-- BUTTON UPDATE START -->
                            <a href="{{ path('actualiser', { 'id': sportbet.footballMatch.id,'footballMatch': sportbet.footballMatch.id }) }}" class=" col btn btn-ml btn-primary mt-2 text-light">Mise à jour</a>
                            <!-- BUTTON UPDATE END -->

                            <!-- BUTTON TRIGGER MODAL DELETE START -->
                            <button type="button" class="btn btn-ml btn-danger mt-2 text-light" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                Supprimer
                            </button>
                            <!-- BUTTON DELETE  END -->

                            <!-- MODAL DELETE START -->
                            <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5 text-dark" id="deleteModalLabel">Suppression Pari-Sportif</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-dark">
                                            Êtes vous sûr de vouloir supprimer votre Pari ?
                                        </div>
                                        <div class="modal-footer">
                                            <a href="" class="btn btn-primary" data-bs-dismiss="modal">Conserver Pari</a>
                                            <a href="{{ path('supprimer', { 'id' : sportbet.footballMatch.id ,'footballMatch': sportbet.footballMatch.id }) }}" class=" btn btn-danger text-light">Supprimer</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- MODAL DELETE END -->

                        {% endif %}
                    </td>

                    {% endfor %}
                </tr>

                </tbody>
            </table>

        </div>
    </div>
    <!-- SPORT BET  HISTORY START -->

    </main>

    <!--  USER INFORMATIONS  END -->

{% endblock %}