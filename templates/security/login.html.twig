{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

    <!-- LOGIN FORM START -->
    <form method="post" class="container">


       {% if app.user %}
        <div class="mb-3">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
        </div>
        {% endif %}

          <!-- LOGO  START -->
           <div class=" text-center">
             <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="logo superBowl">
           </div>
          <!-- LOGO  END -->

        <h1 class="h3 mb-3 mt-5 text-center">Connexion</h1>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}


        <!-- EMAIL  START -->
       <label for="inputEmail">Email</label>
          <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control mb-3" autocomplete="email" required autofocus>
        <!-- EMAIL  END -->

        <!-- PASSWORD  START -->
        <label for="inputPassword">Mot de passe</label>
           <input type="password" name="password" id="inputPassword" class="form-control mb-3" autocomplete="current-password" required>
         <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <!-- PASSWORD  END -->

    {#
        Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
        See https://symfony.com/doc/current/security/remember_me.html

        <div class="checkbox mb-3">
            <label>
                <input type="checkbox" name="_remember_me"> Remember me
            </label>
        </div>
    #}
            <!-- BUTTON  START -->
           <div class=" mb-3 mt-5 text-center">
                <button class="btn btn-lg btn-primary " type="submit">
                    Se Connecter
                </button>
           </div>
            <!-- BUTTON  END -->

        <!-- FORGET PASSWORD START -->
        <p class="text-center mt-2 text-light"><a class="text-light" href="{{ path('forgotpassword_request') }}" > Mot de passe oublié ? </a></p>
        <!-- FORGET PASSWORD END -->

    </form>

    <!-- LOGIN FORM END -->
{% endblock %}
