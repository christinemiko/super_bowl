{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

    <!-- LOGIN FORM START -->
    <form method="post" class="container-md form-login">

          <!-- LOGO & TITLE LOGIN  START -->
           <div class="text-center">
             <img src="{{ asset('img/img34.png') }}" class="img-login" alt="logo superBowl">
           </div>
          <!-- LOGO & TITLE LOGIN  END -->

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <!-- ERROR MESSAGE FOR ENABLE USER FALSE START -->
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}
        <!-- ERROR MESSAGE FOR ENABLE USER FALSE END -->

        <!-- EMAIL  START -->
          <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control mb-3 input-login" placeholder="E-mail" autocomplete="email" required autofocus>

        <!-- EMAIL  END -->

        <!-- PASSWORD  START -->
           <input type="password" name="password" id="inputPassword" class="form-control mb-3 input-login" placeholder="Mot de Passe" autocomplete="current-password" required>
             <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <!-- PASSWORD  END -->

            <!-- BUTTON  START -->
           <div class="text-center mt-4">
                <button class="btn btn-lg btn-danger login-btn" type="submit">
                    Se Connecter
                </button>
           </div>
            <!-- BUTTON  END -->

        <!-- LINKS START -->
        <p class="text-center mt-4 mb-5 text-light anton-regular5">
            <a class="text-light" href="{{ path('inscription') }}">Inscrivez-vous !</a>
            &nbsp;|&nbsp;
            <a class="text-light" href="{{ path('forgotpassword_request') }}">Mot de passe oublié ?</a>
        </p>
        <!-- LINKS END -->


    </form>

    <!-- LOGIN FORM END -->
{% endblock %}
