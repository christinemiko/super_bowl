{% extends "base.html.twig" %}

{% block title %}Oublie Mot de Passe{% endblock %}

{% block body %}


    <main>

            <!-- LOGO & TITLE PASSWORD  START -->
            <div class=" block text-center">
                <img src="{{ asset('img/img42.png') }}" class="img-login" alt="Logo SuperBowl">

                <div class="text-center text-light">
                    <p>Vous avez oublié votre mot de passe ?</p>
                    <p>Insérez votre E-mail.</p>
                    <p>Vous allez recevoir un E-mail de modification de mot de passe immédiatement, à cette adresse.</p>
                </div>

            </div>
            <!-- LOGO & TITLE PASSWORD  END -->

        <!-- FORM FORGOT PASSWORD  START -->
            <div class="container-md">
                <div class="row justify-content-center">

                    <!-- FLASH MESSAGE START -->
                    {% for flashError in app.flashes('error') %}
                        <div class="alert alert-danger">
                            {{ flashError }}
                        </div>
                    {% endfor %}
                    <!-- FLASH MESSAGE END -->

                    <!-- FORM INPUT EMAIL START -->
                    <div class="col-md-6 col-sm-8">
                        {{ form_start(form) }}

                        <div class="form-field-label">
                            {{ form_row(form.email,{
                                'attr': {'placeholder': 'Email'}
                            }) }}
                        </div>

                        <!-- BUTTON CONFIRM START -->
                        <div class="text-center mt-4 mb-5">
                            <button type="submit" class="btn btn-lg btn-danger mt-2 regis-btn">Confirmer</button>
                            {{ form_end(form) }}
                        </div>
                        <!-- BUTTON CONFIRM END -->

                    </div>
                    <!-- FORM INPUT EMAIL START -->

                </div>
            </div>
        <!-- FORM FORGOT PASSWORD  END -->

    </main>

    <!--FORMULAIRE INSCRIPTION END -->

{% endblock %}

