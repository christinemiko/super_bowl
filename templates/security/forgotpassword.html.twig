{% extends "base.html.twig" %}

{% block title %}Oublie Mot de Passe{% endblock %}

{% block body %}


    <main class="container-fluid">

        <div class=" block text-center">
            <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="Logo SuperBowl">
            <h3 class="mt-5 text-center text-light">Oublie Mot de passe</h3>
        </div>

        <div class="container">
            <div class="row">

                <!-- FLASH MESSAGE START -->
                {% for flashError in app.flashes('error') %}
                    <div class="alert alert-danger">
                        {{ flashError }}
                    </div>
                {% endfor %}
                <!-- FLASH MESSAGE END -->

                <div class="text-center mt-5">
                    <p> Veuillez insérer votre email. </p>
                    <p>Vous allez recevoir un email de modification de Mot de Passe, sur cette adresse.</p>

                    {{ form_start(form) }}

                    <div class="mt-5">
                        {{ form_row(form.email) }}
                    </div>

                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-md btn-danger mt-5 text-dark">Confirmer</button>
                        {{ form_end(form) }}
                    </div>

                </div>

            </div>
        </div>

    </main>

    <!--FORMULAIRE INSCRIPTION END -->

{% endblock %}

