{% extends "base.html.twig" %}

{% block title %}Mon Espace{% endblock %}

{% block body %}

    <!-- MY ACCOUNT START -->
    <main>

        <!-- LOGO  START -->
        <div class=" text-center">
            <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="logo superBowl">
        </div>
        <!-- LOGO  END -->

        <!-- TITTLE START -->
        <div class="mb-5 orange mt-5"><h2 class="text-center text-light rectangle2">Mon Espace</h2>
        </div>
        <!-- TITTLE END -->

        <!-- SPORT BET GRAPHIC USER START -->
        <div class="container">
            <h3 class="text-center"> Statistiques des Paris Sportif</h3>
        </div>

        <!-- CHART START -->
        <div class="container">
            <canvas id="myGraphic"></canvas>
        </div>
        <!-- CHART END -->

        <!-- CHART TITTLE START-->
        <script>
            Chart.defaults.plugins.title.display = true;
            Chart.defaults.plugins.title.text = "MATCHS TERMINES";
            Chart.defaults.plugins.title.color = "red";

        </script>
        <!-- CHART TITTLE END-->

        <!-- SPORT BET GRAPHIC USER START -->
        <script>

            const ctx = document.getElementById('myGraphic');


            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet'],
                    datasets: [
                          {
                             label: 'Paris-Sportifs',
                              data:{{ wagerMadeData|raw }},
                             borderWidth: 1
                          },

                        {
                            label: 'Gains',
                            data: {{ moneyGainData|raw }},
                            borderWidth: 2
                        },

                        {
                            label: 'Perte',
                            data:{{ moneyLoseData|raw }},
                            borderWidth: 3
                        },

                    ]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        </script>
        <!-- SPORT BET GRAPHIC USER END -->

        <!-- SPORT BET FINISHED HISTORY START -->
        <div class="container-fluid">
            <div class="table-responsive">
                <table class="table table-light table-striped table-bordered table-hover">
                    <thead >
                    <tr>

                        <th class="text-center">Date du Match</th>
                        <th class="text-center">Statut Match</th>
                        <th class="text-center">Noms des équipes</th>
                        <th class="text-center">Date Mise</th>
                        <th class="text-center">Mise effectuée</th>
                        <th class="text-center">Gains</th>
                        <th class="text-center">Pertes</th>
                        <th></th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for sportbet in sportbets %}
                        {% if sportbet.footballMatch.statut == 'Terminé' %}
                    <tr>
                        <td class="text-center">{{ sportbet.footballMatch.matchDate|date('d/m/Y')}}</td>
                        <td class="text-center">{{ sportbet.footballMatch.statut }}</td>
                        <td class="text-center">{{ sportbet.team.teamName }}</td>
                        <td class="text-center">{{ sportbet.dateWagerMade|date('d/m/Y')}}</td>
                        <td class="text-center">{{ sportbet.wagerMade }}</td>
                        <td class="text-center">{{ sportbet.moneyGain }}</td>
                        <td class="text-center">{{ sportbet.moneyLose }}</td>
                        <td></td>

                        {% endif %}

                        {% endfor %}
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
                <!-- SPORT BET FINISHED HISTORY END -->
    </main>
    <!-- MY ACCOUNT END -->

{% endblock %}

{% block javascripts %}

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


{% endblock %}