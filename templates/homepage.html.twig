{% extends "base.html.twig" %}

{% block title %}Accueil{% endblock %}

{% block body %}
<!-- HOME PAGE START -->
<main>
    <!-- LOGO  START -->
    <div class=" text-center">
        <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="logo superBowl">
    </div>
    <!-- LOGO  END -->

    <section>
        <div class="container">
            <h4 class="text-center mt-3"><i>"Cet évènement planétaire s'est fait une place de choix en France,</i></h4>
            <h4 class="text-center  mb-5"><i> Suivez l'intégralité des matchs, retransmis en Live depuis les USA, au State Farm Center de Glendale." </i></h4>
        <!--BUTTON MATCH START -->
        <div class="text-center mb-5"><a href="{{ path('visualiserlesmatchs') }}" class="btn btn-primary btn-ml">Visualiser tous les Matchs</a></div>
        </div>
        <!-- BUTTON MATCH END -->
            <div class="row justify-content-center">

                    <!--CAROUSEL  PICTURES START -->

                    <div id="carouselLieu"  class="carousel slide full-screen-carousel" data-bs-ride="carousel" data-bs-interval="3000">
                        <div class="carousel-inner">

                            <!-- CARROUSEL PICTURE1 START -->
                            <div class="carousel-item active">
                                <img src="{{ asset('img/img25.png') }}"  class=" img-fluid d-block w-100" alt="image1">
                                <div class="carousel-caption">
                                </div>
                            </div>
                            <!-- CARROUSEL PICTURE1 END -->

                            <!-- CARROUSEL PICTURE2 START -->
                            <div class="carousel-item">
                                <img src="{{ asset('img/img26.png') }}"  class="img-fluid d-block w-100" alt="image13">
                                <div class="carousel-caption">
                                </div>
                            </div>
                            <!-- CARROUSEL PICTURE2 END -->

                            <!-- CARROUSEL PICTURE3 START -->
                            <div class="carousel-item">
                                <img src="{{ asset('img/img27.png') }}"  class="img-fluid d-block w-100" alt="image8">
                                <div class="carousel-caption">
                                </div>
                            </div>
                            <!-- CARROUSEL PICTURE3 END -->

                        </div>
                    </div>
                <!--CAROUSEL  PICTURES END -->
            </div>

        <!--MATCH TODAY START -->
        <div class="mb-5 red"><h2 class="text-center rectangle1"> Les Matchs du jour</h2></div>

        <!--CARD MATCH TODAY  START -->
        <div class="container">
            <div class="row justify-content-around align-items-center">

                {% for footballMatch in footballMatches %}

                <div class="card mt-5" style="width: 25rem;">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">

                            <!-- DATE MATCH START -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar3" viewBox="0 0 16 16">
                                <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                                <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                            </svg> {{footballMatch.matchDate|date('d/m/Y')}}
                            <!-- DATE MATCH END -->

                            <!-- HOUR MATCH START -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
                                <path d="M8.5 5.6a.5.5 0 1 0-1 0v2.9h-3a.5.5 0 0 0 0 1H8a.5.5 0 0 0 .5-.5V5.6z"/>
                                <path d="M6.5 1A.5.5 0 0 1 7 .5h2a.5.5 0 0 1 0 1v.57c1.36.196 2.594.78 3.584 1.64a.715.715 0 0 1 .012-.013l.354-.354-.354-.353a.5.5 0 0 1 .707-.708l1.414 1.415a.5.5 0 1 1-.707.707l-.353-.354-.354.354a.512.512 0 0 1-.013.012A7 7 0 1 1 7 2.071V1.5a.5.5 0 0 1-.5-.5zM8 3a6 6 0 1 0 .001 12A6 6 0 0 0 8 3z"/>
                            </svg>Début:{{footballMatch.hourStart|date('H:i')}}_

                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-stopwatch" viewBox="0 0 16 16">
                                <path d="M8.5 5.6a.5.5 0 1 0-1 0v2.9h-3a.5.5 0 0 0 0 1H8a.5.5 0 0 0 .5-.5V5.6z"/>
                                <path d="M6.5 1A.5.5 0 0 1 7 .5h2a.5.5 0 0 1 0 1v.57c1.36.196 2.594.78 3.584 1.64a.715.715 0 0 1 .012-.013l.354-.354-.354-.353a.5.5 0 0 1 .707-.708l1.414 1.415a.5.5 0 1 1-.707.707l-.353-.354-.354.354a.512.512 0 0 1-.013.012A7 7 0 1 1 7 2.071V1.5a.5.5 0 0 1-.5-.5zM8 3a6 6 0 1 0 .001 12A6 6 0 0 0 8 3z"/>
                            </svg>Fin:{{footballMatch.hourFinish|date('H:i')}}
                            <!-- HOUR MATCH END -->
                        </li>

                        <!-- TEAM 1 & TEAM 2 LOGO AND NAME START -->
                        <li class="list-group-item team-name">
                            <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam" alt="logo">
                            {{ footballMatch.team1.teamName }}
                        </li>

                        <li class="list-group-item team-name">
                            <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam" alt="logo">
                            {{ footballMatch.team2.teamName }}</li>
                        <!-- TEAM 1 & TEAM 2 LOGO AND NAME END -->

                        <!-- BUTTON WATCH ONE MATCH START -->
                        <a href="{{ path('visualiserunmatch', { 'id': footballMatch.id }) }}" class="card-link text-center btn btn-warning mt-2 mb-2">Visualiser le Match</a>
                        <!-- BUTTON WATCH ONE MATCH END -->

                    </ul>
                </div>
                {% endfor %}
            </div>
        </div>

        <!--CARD MATCH TODAY END-->

        <!--MATCH TODAY END -->
    </section>

</main>

{% endblock %}