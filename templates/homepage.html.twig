{% extends "base.html.twig" %}

{% block title %}Accueil{% endblock %}

{% block body %}
<!-- HOME PAGE START -->
<main>
    <div class="container mb-2">

        <!--  PICTURE1 START -->
        <div class="image-text-container">
                <img src="{{ asset('img/img32.png') }}"  class=" img-home" alt="superbowl">


            <div class="text-button-container">
                   <!--  TITLE GAME ON START-->
                    <img src="{{ asset('img/img33.png') }}"  class="img-title-game text-center" alt="gameon">
                    <p class="text-center anton-regular2 mb-5 neon-text"> 2024 </p>
                    <!--  TITLE GAME ON END -->

                    <!-- BUTTON MATCHS -->
                   <a href="{{ path('visualiserlesmatchs') }}" class="btn btn-danger btn-ml btn-round">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16">
                            <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/>
                        </svg>
                        VISUALISER TOUS LES MATCHS
                   </a>
                    <!-- BUTTON MATCHS -->

                    <!-- TEXT INTRO  -->
                     <div class="intro-home">
                           <h4 class="anton-regular mt-5"><i>"Cet évènement planétaire s'est fait une place de choix en France,</i></h4>
                           <h4 class="anton-regular"><i>Suivez l'intégralité des matchs, retransmis en Live depuis les USA, au State Farm Center de Glendale."</i></h4>
                     </div>
                    <!-- TEXT INTRO  -->
            </div>

        </div>
    </div>
    <!--  PICTURE1 END -->

    <section>

        <!--MATCH TODAY START -->
        <h2 class="text-center anton-regular2 mt-5 neon-text"> MATCHS DU JOUR </h2>

        <!--CARD MATCH TODAY  START -->
        <div class="container">
            <div class="row justify-content-center align-items-center">

                {% for footballMatch in footballMatches %}

                    {% include '_card.html.twig' with {'footballMatch': footballMatch} %}

                {% endfor %}
            </div>
        </div>

        <!--CARD MATCH TODAY END-->

        <!--SOCIAL LINK START -->
        <!-- Section: Social media -->
        <section class="d-flex justify-content-between mt-5 p-4 red">

            <!-- Left -->
            <div class="match-status me-5">
                <span>Retrouvez nous sur les réseaux sociaux:</span>
            </div>
            <!-- Left -->

            <!-- Right -->
            <div class="justify-content-around">
                <a class="text-white me-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-facebook" viewBox="0 0 16 16">
                        <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/>
                    </svg></a>

                <a class="text-white me-4"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-twitter-x" viewBox="0 0 16 16">
                        <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
                    </svg></a>

                <a  class="text-white  mt-2 me-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-instagram" viewBox="0 0 16 16">
                        <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
                    </svg>
                </a>
            </div>
            <!-- Right -->

        </section>
        <!-- Section: Social media -->

        <!-- Section: Links  -->
        <section class="">
            <div class="container text-center text-md-start mt-5">
                <!-- Grid row -->
                <div class="row mt-3">

                    <!-- Grid column -->
                    <div class="col-md-3 col-lg-4 col-xl-3 mx-auto mb-4">
                        <!-- Content -->

                        <h6>SUPER BOWL OFFICIAL</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto footer-line"/>
                        <p>
                            Retrouvez le meilleur des paris sportifs durant le super Bowl 2024
                            avec toutes les équipes officielles de la NFL .
                        </p>
                    </div>
                    <!-- Grid column -->

                    <!-- Grid column -->
                    <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mb-4">
                        <!-- Links -->
                        <h6>Informations</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto footer-line"/>
                        <p>
                            <a href="#!" class="text-white">Règlements</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white">CGU</a>
                        </p>
                        <p>
                            <a href="#!" class="text-white">Politique de confidentialité</a>
                        </p>
                    </div>
                    <!-- Grid column -->

                    <!-- Grid column -->
                    <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                        <!-- Links -->
                        <h6>Liens</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto footer-line"/>
                        <p>
                            <a href="{{ path('app_login') }}" class="text-white">Votre espace personnel</a>
                        </p>
                        <p>
                            <a href="{{ path('inscription') }}" class="text-white">Inscrivez vous</a>
                        </p>
                        <p>
                            <a href="{{ path('parier') }}" class="text-white">Parier sur les matchs</a>
                        </p>
                        <p>
                            <a href="mailto:superbowl.aide@nfl.com" class="text-white">Aide</a>
                        </p>
                    </div>
                    <!-- Grid column -->

                    <!-- Grid column -->
                    <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mb-md-0 mb-4">
                        <!-- Links -->
                        <h6>Contact</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto footer-line"/>
                        <p><i class="fas fa-home mr-3"></i> New York, NY 10012, US</p>
                        <p><i class="fas fa-envelope mr-3"></i> <a href="mailto:superbowl@nlf.com" class="email-link">superbowl@nlf.com</a></p>
                    </div>
                    <!-- Grid column -->
                </div>
                <!-- Grid row -->
            </div>
        </section>

        <!--SOCIAL LINK END -->
    </section>

</main>

{% endblock %}