{% extends "base.html.twig" %}

{% block title %}Accueil{% endblock %}

{% block body %}
<!-- HOME PAGE START -->
<main>
    <!-- LOGO  START -->
    <div class=" text-center">
        <img src="{{ asset('img/logo4.png') }}" class="img-fluid" alt="logo superBowl">
    </div>
    <!-- LOGO  END -->

    <section>
        <div class="container">
            <h4 class="text-center mt-3 anton-regular"><i>"Cet évènement planétaire s'est fait une place de choix en France,</i></h4>
            <h4 class="text-center mb-5 anton-regular"><i> Suivez l'intégralité des matchs, retransmis en Live depuis les USA, au State Farm Center de Glendale." </i></h4>
        <!--BUTTON MATCH START -->
        <div class="text-center mb-5">
            <a href="{{ path('visualiserlesmatchs') }}" class="btn btn-danger btn-ml btn-round anton-regular">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16">
                    <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/>
                </svg>
                VISUALISER TOUS LES MATCHS
            </a>
        </div>
        </div>
        <!-- BUTTON MATCH END -->
            <div class="row justify-content-center">

                            <!-- CARROUSEL PICTURE1 START -->
                            <div class="">
                                <img src="{{ asset('img/img33.png') }}"  class=" img-fluid d-block w-100" alt="image1">
                            </div>
                            <!-- CARROUSEL PICTURE1 END -->
            </div>

        <!--MATCH TODAY START -->
        <h2 class="text-center rectangle1 anton-regular2"> MATCHS DU JOUR</h2>

        <!--CARD MATCH TODAY  START -->
        <div class="container">
            <div class="row justify-content-around align-items-center">

                {% for footballMatch in footballMatches %}

                <div class="card mt-5 h-100" style="width: 25rem;">
                    <ul class="list-group list-group-flush">
                        <li class="text-center" style="list-style-type: none;">

                            <!-- DATE MATCH START -->
                           <div class="text-center mt-2"> Le {{footballMatch.matchDate|date('d/m/Y')}} </div>
                            <!-- DATE MATCH END -->

                            <!-- HOUR MATCH START -->
                           <div class="text-center mt-2">
                               Début {{footballMatch.hourStart|date('H:i')}}
                               Fin {{footballMatch.hourFinish|date('H:i')}}
                           </div>
                             <div class="text-center mt-2 mb-2">{{footballMatch.statut}} </div>
                            <!-- HOUR MATCH END -->
                        </li>

                        <!-- TEAM 1 & TEAM 2 LOGO AND NAME START -->
                            <div class="text-center mt-2 mb-2">
                            <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam" alt="logo">
                            {{ footballMatch.team1.teamName }}
                            </div>

                            <div class=" text-center mt-2 mb-2">
                                <img src="{{ asset('img/teams/vs.png') }}" class="imgteam" alt="logo">
                            </div>

                            <div class="text-center  mt-2 mb-2">
                            <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam" alt="logo">
                            {{ footballMatch.team2.teamName }}
                            </div>

                        <!-- TEAM 1 & TEAM 2 LOGO AND NAME END -->

                        <!-- BUTTON WATCH ONE MATCH START -->
                        <li class="text-center mt-2" style="list-style-type: none;">Score : {{ footballMatch.scoreTeam1 }}  _  {{ footballMatch.scoreTeam2 }}</li>
                        <a href="{{ path('visualiserunmatch', { 'id': footballMatch.id }) }}" class="btn btn-secondary mt-2 mb-2">Visualiser le Match</a>
                        <!-- BUTTON WATCH ONE MATCH END -->

                    </ul>

                </div>
                {% endfor %}
            </div>
        </div>

        <!--CARD MATCH TODAY END-->

        <!--MATCH TODAY END -->
    </section>

</main>

{% endblock %}