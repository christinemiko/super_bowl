{% extends "base.html.twig" %}

{% block title %}Accueil{% endblock %}

{% block body %}
<!-- HOME PAGE START -->
<main>
    <div class="container mb-2">

        <!--  PICTURE1 START -->
        <div class="image-text-container">
            <img src="{{ asset('img/img32.png') }}"  class=" img-fluid" alt="superbowl">

            <div class="text-button-container">
                <img src="{{ asset('img/img33.png') }}"  class="img-title-game text-center" alt="gameon">
                <p class="text-center anton-regular2 mb-5"> 2024 </p>

               <a href="{{ path('visualiserlesmatchs') }}" class="btn btn-danger btn-ml btn-round anton-regular">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16">
                    <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/>
                </svg>
                VISUALISER TOUS LES MATCHS
               </a>
                <h4 class="anton-regular mt-5 mb-5"><i>"Cet évènement planétaire s'est fait une place de choix en France,</i></h4>
                <h4 class="anton-regular"><i>Suivez l'intégralité des matchs, retransmis en Live depuis les USA, au State Farm Center de Glendale."</i></h4>
            </div>

        </div>
        <!--  PICTURE1 END -->

    </div>
    <section>

        <!--MATCH TODAY START -->
        <h2 class="text-center anton-regular2 mt-5"> MATCHS DU JOUR </h2>

        <!--CARD MATCH TODAY  START -->
        <div class="container">
            <div class="row justify-content-around align-items-center">

                {% for footballMatch in footballMatches %}

                <div class="card  mt-5 mb-5 h-100" style="width: 25rem;">
                    <ul class="list-group list-group-flush">
                        <li class="text-center" style="list-style-type: none;">

                            <!-- DATE MATCH START -->
                           <div class="text-center mt-2"> Le {{footballMatch.matchDate|date('d/m/Y')}} </div>
                            <!-- DATE MATCH END -->

                            <!-- HOUR MATCH START -->
                           <div class="text-center mt-2">
                               Début {{footballMatch.hourStart|date('H:i')}}
                               Fin {{footballMatch.hourFinish|date('H:i')}}
                           </div>
                            <!-- HOUR MATCH END -->

                            <!-- STATUS MATCH  -->
                             <div class="match-status text-center text-danger mt-2 mb-2">{{footballMatch.statut}} </div>

                        </li>

                        <!-- TEAM 1 & TEAM 2 LOGO AND NAME START -->
                            <div class="row mt-2 mb-2 text-center">

                                <!-- Column Logo team 1 -->
                                <div class="col">
                                    <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam" alt="logo">
                                </div>

                                <!-- Column team 1 Name -->
                                <div class="col d-flex justify-content-center align-items-center">
                                    {{ footballMatch.team1.teamName }}
                                </div>

                                <!--  VS LOGO START -->
                                <div class=" text-center mt-2 mb-2">
                                    <img src="{{ asset('img/teams/vs.png') }}" class="imgteam" alt="logo">
                                </div>
                                <!--  VS LOGO END -->

                                <!-- Column Logo team 2 -->
                                <div class="col">
                                <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam" alt="logo">
                                </div>

                                <!-- Column team 2 Name -->
                                <div class="col d-flex justify-content-center align-items-center">
                                    {{ footballMatch.team2.teamName }}
                                </div>

                            </div>

                        <!-- TEAM 1 & TEAM 2 LOGO AND NAME END -->

                        <!-- BUTTON WATCH ONE MATCH START -->
                        <li class="team-score text-center mt-2" style="list-style-type: none;"> Score : {{ footballMatch.scoreTeam1 }}  -  {{ footballMatch.scoreTeam2 }}</li>
                        <a href="{{ path('visualiserunmatch', { 'id': footballMatch.id }) }}" class="btn btn-secondary mt-2 mb-2">Visualiser le Match</a>
                        <!-- BUTTON WATCH ONE MATCH END -->

                    </ul>

                </div>
                {% endfor %}
            </div>
        </div>

        <!--CARD MATCH TODAY END-->

        <!--MATCH TODAY END -->
    </section>

</main>

{% endblock %}