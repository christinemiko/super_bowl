{% extends "base.html.twig" %}

{% block title %}Parier sur tous les Matchs{% endblock %}

{% block body %}

<!--  BET ALL MATCHES PAGE START -->
 <main class="mb-5">

     <!-- INTRODUCTION  START   -->
     <div class="text-center">
         <img src="{{ asset('img/img38.png') }}" class="" alt="Parier image">
     </div>
     <!-- INTRODUCTION  END   -->

     <!--CARD BET MATCH  START -->

             <!--TITLE BET MATCH  START -->
             <h2 class="text-center anton-regular2 mt-5 neon-text"> FAITES VOS JEUX </h2>
             <!--TITLE BET MATCH  END -->

     <div class="container">
         <form action="{{ path('roadselections') }}" method="post" class="text-center">

             {% if app.user %}
             <button type="submit" class=" col-6 btn btn-lg btn-danger">Parier sur les sélections</button>
             {% endif %}

             <div class="row justify-content-center align-items-center">

                 {% for footballMatch in footballMatches %}

                     {% include '_cardbet.html.twig' with {'footballMatch': footballMatch} %}

                 {% endfor %}
             </div>
         </form>
     </div>


     <!--CARD MATCH COMING END-->

 </main>
    <!--  BET ALL MATCHES PAGE END -->

{% endblock %}