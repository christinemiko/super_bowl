{% extends "base.html.twig" %}

{% block title %}Visualiser les Matchs{% endblock %}

{% block body %}

<!--  WATCH ALL MATCHES PAGE START -->
    <main class="mb-5">
        <div class="container mb-2">

        <!-- INTRODUCTION  START   -->
              <div class="image-text-container" >
                  <img src="{{ asset('img/img37.png') }}" class="img-home" alt="Game day image">

                      <!--  TITLE GAME ONLINE START-->
                  <div class="text-button-container">
                      <h1 class="text-center anton-regular2 text-danger"><i> FOOTBALL </i></h1>
                      <h2 class="text-center anton-regular3">MATCH</h2>
                      <img src="{{ asset('img/online.png') }}"  class="img-title-game text-center img-online" alt="online">

                      <p class="text-center anton-regular4 intro-allmatchs mt-5 mb-5">
                          Suivez tous les matchs en direct  passés ou à venir </p>
                      <!--  TITLE GAME ONLINE END -->



                  </div>
              </div>
        </div>
        <!-- INTRODUCTION  END   -->

        <!-- TITLE MATCH TODAY START -->
        <h2 class="text-center anton-regular2 mt-5 neon-text"> MATCHS DU JOUR </h2>

            <!--CARD MATCH TODAY  START -->
                <div class="container">
                    <div class="row justify-content-center align-items-center">

                        {% for footballMatch in footballMatches %}

                            {% include '_card.html.twig' with {'footballMatch': footballMatch} %}

                        {% endfor %}
                    </div>
                </div>
            <!--CARD MATCH TODAY END-->

        <!--TITLE MATCH COMING  START -->
        <h2 class="text-center anton-regular2 mt-5 neon-text">MATCHS A VENIR</h2>

                <!--CARD MATCH COMING START -->
                    <div class="container">
                        <div class="row justify-content-center align-items-center ">

                            {% for footballMatch2 in footballMatches2 %}


                            {% include '_card.html.twig' with {'footballMatch': footballMatch2} %}


                            {% endfor %}
                        </div>
                    </div>

                <!--CARD MATCH COMING END-->

        <!--TITLE MATCH FINISH START -->
        <h2 class="text-center anton-regular2 mt-5 neon-text"> MATCHS TERMINES</h2>

                <!--CARD MATCH FINISHED  START -->
                    <div class="container">
                        <div class="row justify-content-center align-items-center">

                            {% for footballMatch3 in footballMatches3 %}

                                {% include '_card.html.twig' with {'footballMatch': footballMatch3} %}

                            {% endfor %}
                        </div>
                    </div>
              <!--CARD MATCH FINISHED  END-->

        </div>
    </main>

{% endblock %}