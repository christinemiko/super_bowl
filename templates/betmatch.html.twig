{% extends "base.html.twig" %}

{% block title %}Parier sur un Match{% endblock %}

{% block body %}

   <!--  BET MATCH PAGE START -->
  <main>
    <!-- INTRODUCTION  START   -->
    <div class="text-center"><img src="{{ asset('img/logo3NLF.png') }}" class="img-fluid imgNLF" alt="NLF logo"></div>
    <h1 class="text-center">Miser</h1>
    <div class="d-flex justify-content-center"><img src="{{ asset('img/img31.png') }}" class=" img-fluid d-block w-90" alt="image miser"></div>
    <!-- INTRODUCTION  END   -->

    <div class="mb-2 red"><h2 class="text-center rectangle1"> Les équipes</h2></div>
    <div class="container">

    <!--TEAMS INFORMATIONS START -->
      <!-- BLOCK TEAM 1 DESCRIPTION  START-->
      <div class="row justify-content-center">
        <div class="rectangle2 white text-center text-dark mt-2">
          <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam mb-2 text-center " alt="logo">
          <h4 class="mt-2 mb-3"> Equipe: {{ footballMatch.team1.teamName }} </h4>
          <p> Cote de l'équipe: {{ footballMatch.team1.oddsteam }}</p>
        </div>
      </div>
      <!-- BLOCK TEAM 1 DESCRIPTION  END-->

      <!-- BLOCK TEAM 2 DESCRIPTION  START-->
      <div class="row justify-content-center">
        <div class="rectangle2 white text-center text-dark mt-2">
          <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam mb-2 text-center " alt="logo">
          <h4 class="mt-2 mb-3"> Equipe: {{ footballMatch.team2.teamName }} </h4>
          <p> Cote de l'équipe: {{ footballMatch.team2.oddsteam }}</p>
        </div>
      </div>
      <!-- BLOCK TEAM 2 DESCRIPTION  END-->
      <!--TEAMS INFORMATIONS END -->

      {{ form_start(form) }}
      <!-- MONEY BET START -->
     <div class="row justify-content-center">
       <div class=" rectangle2 blue text-center col-sm mt-2">
         <h4 class="text-center">Mise</h4>

         <p class="text-center mt-5 mb-5"> Sélectionner l'équipe sur laquelle vous souhaitez miser :</p>
         <div class="text-center mb-2">{{ form_row(form.team) }}</div>

         <div class="text-center col-6 mx-auto mt-5 mb-5" >{{ form_row(form.wagerMade) }}</div>

         <div class="text-center col-6 mx-auto mb-2 mb-5">{{ form_row(form.datewagerMade) }}</div>

       </div>
     </div>
      <!-- MONEY BET END -->

      <!-- BUTTON CONFIRM START-->
        <div class="text-center mt-3">
                <button type="submit" class="btn btn-lg btn-danger">Validation</button>
        </div>

        <!-- BUTTON CONFIRM END-->
      {{ form_end(form) }}

    </div>
  </main>
    <!--  BET MATCH PAGE END -->
{% endblock %}

{% block custom_javascripts %}

          <!-- FLATPICKR   CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

            <script>

              flatpickr('.flatpickr-date', {
                       dateFormat: 'Y-m-d',
                       locale: 'fr',
                       disableMobile: true,
                       defaultDate: 'today',
                       minDate: 'today',
                       altInput: true,
                       altFormat: 'd M Y',
                       disable: [
                       function(date) {
                        return (date.getDay() === 0); // 0 = dimanche
                      }
                    ],

                  });

            </script>
{% endblock %}