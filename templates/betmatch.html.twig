{% extends "base.html.twig" %}

{% block title %}Parier sur un Match{% endblock %}

{% block body %}

   <!--  BET MATCH PAGE START -->
  <main>

      <!-- INTRODUCTION  START   -->
          <div class="container mb-2">
              <div class="image-text-container">
                  <!-- PICTURE MATCH WIN  START -->
                  <img src="{{ asset('img/img46.png') }}" class="img-home" alt="Match win image">
                  <!-- PICTURE MATCH WIN END -->

                  <div class=" row justify-content-center">

                          <div class="text-button-container">

                              <!--  TITLE  CREATE MATCH START-->
                              <img src="{{ asset('img/img47.png') }}"  class="img-title-game2 text-center" alt="logo super bowl">
                              <!--  TITLE  CREATE MATCH END -->

                                  <!-- TEAM1 LOGO & NAME -->
                                  <p class="detail-match-name mt-5">
                                      <img src="{{ asset('img/teams/' ~ footballMatch.team1.link) }}" class="imgteam mb-2 text-center " alt="logo team1 & name">
                                      {{ footballMatch.team1.teamName }}<br> Cote de l'équipe: {{ footballMatch.team1.oddsteam }}
                                  </p>
                                  <!-- VS LOGO -->
                                  <img src="{{ asset('img/vs2.png') }}" class="imgteam" alt="Match-stade picture">

                                  <!-- TEAM2 LOGO & NAME -->
                                  <p class="detail-match-name">
                                      <img src="{{ asset('img/teams/' ~ footballMatch.team2.link) }}" class="imgteam mb-2 mt-5 text-center mx-3 " alt="logo team2 & name">
                                      {{ footballMatch.team2.teamName }} <br> Cote de l'équipe: {{ footballMatch.team1.oddsteam }}
                                  </p>

                          </div>
                  </div>
              </div>
          </div>
      <!-- INTRODUCTION  END   -->

      <!--SPORTBET TITLE START -->
      <h2 class="text-center anton-regular2 mt-5 neon-text"> PARI SPORTIF </h2>
      <h2 class="text-center game-title-play mt-5 neon-text"> FAITES VOS JEUX </h2>
      <!--SPORTBET TITLE END -->


      <!--FORM  CREATE BET START -->
     <div class="row justify-content-center">
           <div class="col-sm mt-2 text-center">
               {{ form_start(form) }}

               <!-- SELECT TEAM BET START -->
                 <p class=" game-text-play text-center mt-5 mb-5"> Sélectionnez l'équipe sur laquelle vous souhaitez miser</p>
                 <div class=" game-text-play text-center mb-2"> {{ form_row(form.team) }}</div>
               <!-- SELECT TEAM BET END -->

               <!-- MONEY BET START -->
                 <div class="text-center col-4 mx-auto mt-5 mb-5" >
                     {{ form_row(form.wagerMade) }}
                 </div>
               <!-- MONEY BET END -->

               <!-- DATE BET START -->
                 <div class="text-center col-4 mx-auto mb-2 mb-5">
                     {{ form_row(form.dateWagerMade) }}
                 </div>
               <!-- DATE BET END -->

           </div>
     </div>


      <!-- BUTTON CONFIRM START-->
        <div class="text-center mt-4 mb-5">
                <button type="submit" class="btn btn-lg btn-danger mt-2 regis-btn">
                    Validation
                </button>
        </div>
        <!-- BUTTON CONFIRM END-->
      {{ form_end(form) }}

    </div>
  </main>
    <!--  BET MATCH PAGE END -->
{% endblock %}

{% block custom_javascripts %}

          <!-- FLATPICKR   CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                 <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

            <script>

              flatpickr('.flatpickr-date', {
                       dateFormat: 'Y-m-d',
                       locale: 'fr',
                       disableMobile: true,
                       defaultDate: 'today',
                       minDate: 'today',
                       altInput: true,
                       altFormat: 'd M Y',

                  });

            </script>

{% endblock %}